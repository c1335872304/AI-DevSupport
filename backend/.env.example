APP_NAME=PaiSmart Python
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:9527,http://127.0.0.1:9527

# Default zero-dependency-ish local mode
DATABASE_URL=sqlite+aiosqlite:///./data/paismart.db
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
TASK_MODE=background
SEARCH_BACKEND=database

# JWT: replace in production
JWT_SECRET=change-me-in-production-with-at-least-32-bytes
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=14

# Development convenience. In production change the password or disable bootstrap.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123

# Optional Redis
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Optional Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=file-processing-topic1
KAFKA_GROUP_ID=paismart-python-file-worker

# Optional MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads
MINIO_SECURE=false

# Optional Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=paismart_knowledge
ELASTICSEARCH_BULK_SIZE=100

# OpenAI-compatible LLM. If API key is empty, the app uses a local context-only fallback answer.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# Persist streaming recovery snapshots periodically instead of once per token/chunk.
CHAT_CHECKPOINT_SECONDS=1.0
CHAT_CHECKPOINT_CHARS=512
WEBSOCKET_AUTH_TIMEOUT_SECONDS=10
CONVERSATION_HISTORY_MESSAGES=8
CONVERSATION_HISTORY_CHARS=6000

# OpenAI-compatible embeddings. If API key is empty, deterministic local hash embeddings are used.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=256
EMBEDDING_BATCH_SIZE=10

# Parent-child RAG. Children are retrieved; parents provide answer context.
PARENT_CHUNK_SIZE=1800
CHUNK_SIZE=600
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=120
TOP_K=6
RAG_CANDIDATE_MULTIPLIER=6
RAG_CONTEXT_CHAR_BUDGET=12000
RAG_PARENT_CONTEXT_MAX_CHARS=2600
RAG_MAX_RESULTS_PER_FILE=4

# Agent Runtime (LLM sees tool schemas and may issue multiple calls per turn)
AGENT_ENABLED=true
AGENT_MAX_STEPS=6
AGENT_MAX_PARALLEL_TOOLS=6
AGENT_TOOL_TIMEOUT_SECONDS=20
AGENT_TOOL_RESULT_MAX_CHARS=20000

# Standalone MCP wrapper. Required only when running backend/mcp_server.py.
# Never defaults to admin; set this to the PaiSmart account whose permissions MCP should inherit.
MCP_SERVICE_USERNAME=

# Skill layer (progressive disclosure)
SKILLS_ENABLED=true
# Optional absolute/relative path; default is backend/skills
# SKILLS_DIR=./skills
SKILLS_MAX_ACTIVE=2
SKILLS_MAX_INSTRUCTION_CHARS=12000
SKILLS_REFERENCE_MAX_CHARS=12000
SKILLS_SCRIPT_INPUT_MAX_CHARS=20000
SKILLS_SCRIPT_OUTPUT_MAX_CHARS=20000

# Production runtime
# Existing databases should apply schema migrations before startup: alembic upgrade head
DATABASE_AUTO_CREATE_DEV=true
LLM_STREAM_INCLUDE_USAGE=true
AGENT_TRACE_PERSIST_ENABLED=true
LLM_MINIMUM_BALANCE_TOKENS=1
RATE_LIMIT_REGISTER_MAX=20
RATE_LIMIT_REGISTER_WINDOW_SECONDS=600
RATE_LIMIT_LOGIN_MAX=30
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# Kafka retry / dead-letter queue
KAFKA_DLQ_TOPIC=file-processing-dlq
KAFKA_RETRY_ATTEMPTS=3
KAFKA_RETRY_BACKOFF_SECONDS=2.0

# MCP Streamable HTTP per-client bearer auth.
# For stdio, MCP_SERVICE_USERNAME above remains the explicit process principal.
MCP_AUTH_ENABLED=true
MCP_AUTH_ISSUER_URL=http://127.0.0.1:8000
MCP_RESOURCE_SERVER_URL=http://127.0.0.1:8011/mcp
MCP_REQUIRED_SCOPE=tools:read
# Dynamic external MCP servers. bearerTokenEnv is preferred over embedding a secret here.
# MCP_REMOTE_SERVERS_JSON={"docs":{"url":"http://127.0.0.1:9001/mcp","bearerTokenEnv":"DOCS_MCP_TOKEN","allowedTools":["search"],"readOnly":true}}
MCP_REMOTE_SERVERS_JSON={}

# Stable business Tool facade: keep query_call_log/query_bill/... unchanged while
# switching their implementation from local demo tables to a remote MCP service.
BUSINESS_TOOL_BACKEND=local
BUSINESS_MCP_SERVER=
# Example: {"query_bill":{"tool":"get_invoice","userArgument":"customer_id"}}
BUSINESS_MCP_TOOL_MAP_JSON={}
BUSINESS_MCP_DEFAULT_USER_ARGUMENT=customer_id

# Metrics / tracing
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=paismart-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
