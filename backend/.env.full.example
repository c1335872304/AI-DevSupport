APP_ENV=dev
APP_PORT=8000
CORS_ORIGINS=http://localhost:9527,http://127.0.0.1:9527
JWT_SECRET=replace-with-a-long-random-secret
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-in-production

DATABASE_URL=mysql+aiomysql://root:paismart@127.0.0.1:3306/PaiSmart?charset=utf8mb4
STORAGE_BACKEND=minio
TASK_MODE=kafka
SEARCH_BACKEND=elasticsearch
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
MEMORY_HISTORY_MAX=20
MEMORY_ENTITY_TTL_SECONDS=21600
ROUTE_CACHE_TTL_SECONDS=86400

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=file-processing-topic1
KAFKA_GROUP_ID=paismart-python-file-worker

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads
MINIO_SECURE=false

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=paismart_knowledge
ELASTICSEARCH_BULK_SIZE=100

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=2048

CONVERSATION_HISTORY_MESSAGES=20
CONVERSATION_HISTORY_CHARS=12000


# Parent-child RAG / reranking
PARENT_CHUNK_SIZE=1800
CHUNK_SIZE=600
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=120
TOP_K=6
RAG_CANDIDATE_MULTIPLIER=6
RAG_CONTEXT_CHAR_BUDGET=12000
RAG_PARENT_CONTEXT_MAX_CHARS=2600
RAG_MAX_RESULTS_PER_FILE=4

# Agent Runtime
AGENT_MAX_STEPS=6
AGENT_MAX_PARALLEL_TOOLS=6
AGENT_TOOL_TIMEOUT_SECONDS=20
AGENT_TOOL_RESULT_MAX_CHARS=20000
AGENT_GENERATION_TIMEOUT_SECONDS=180

# Customer-service requests always use the deterministic three-Agent workflow.
AGENT_MAX_CONCURRENCY=3
AGENT_TOOL_GLOBAL_CONCURRENCY=6

# MCP service principal
MCP_SERVICE_USERNAME=

# Skill layer (progressive disclosure)
SKILLS_ENABLED=true
# Optional absolute/relative path; default is backend/skills
# SKILLS_DIR=./skills
SKILLS_MAX_ACTIVE=3
SKILLS_MAX_INSTRUCTION_CHARS=12000
SKILLS_REFERENCE_MAX_CHARS=12000
SKILLS_SCRIPT_INPUT_MAX_CHARS=20000
SKILLS_SCRIPT_OUTPUT_MAX_CHARS=20000
SKILLS_SCRIPT_TIMEOUT_SECONDS=10

# Database migrations / production runtime
DATABASE_AUTO_CREATE_DEV=false
# `python run.py` applies Alembic before Uvicorn when enabled. For several
# independent deploys, run this in the release step instead of every worker.
DATABASE_AUTO_MIGRATE=true
LLM_STREAM_INCLUDE_USAGE=true
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_CIRCUIT_BREAKER_FAILURES=3
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
LLM_MINIMUM_BALANCE_TOKENS=1
RATE_LIMIT_REGISTER_MAX=20
RATE_LIMIT_REGISTER_WINDOW_SECONDS=600
RATE_LIMIT_LOGIN_MAX=30
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_MAX=20
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
CHAT_MAX_INPUT_CHARS=8000
CHAT_MAX_CONNECTIONS_PER_USER=3
CHAT_CONNECTION_TTL_SECONDS=7200
PRIVACY_HISTORY_RETENTION_DAYS=180
PRIVACY_TRACE_RETENTION_DAYS=90
PRIVACY_AUTO_MAINTENANCE_ENABLED=true
PRIVACY_MAINTENANCE_INTERVAL_SECONDS=86400

KAFKA_DLQ_TOPIC=file-processing-dlq
KAFKA_RETRY_ATTEMPTS=3
KAFKA_RETRY_BACKOFF_SECONDS=2.0

# MCP server auth + external MCP client discovery
MCP_AUTH_ENABLED=true
MCP_AUTH_ISSUER_URL=https://your-auth-issuer.example.com
MCP_RESOURCE_SERVER_URL=https://your-paismart.example.com/mcp
MCP_REQUIRED_SCOPE=tools:read
# Dedicated billing MCP facade. It exposes only read-only account facts through
# query_plan/query_usage/query_bill; API diagnostics and knowledge stay local.
BILLING_MCP_ENABLED=false
BILLING_MCP_URL=
BILLING_MCP_BEARER_TOKEN_ENV=BILLING_MCP_TOKEN
BILLING_MCP_TIMEOUT_SECONDS=30

# Langfuse tracing. Set the instance base URL and project keys.
LANGFUSE_ENABLED=true
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
